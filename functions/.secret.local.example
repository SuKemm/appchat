# Copy file này thành ".secret.local" (KHÔNG commit "secret.local" lên git)
# để Firebase Emulator đọc được các secret khi chạy "npm run serve"
# hoặc "firebase emulators:start" ở local.
#
# Khi deploy thật, KHÔNG dùng file này — dùng lệnh:
#   firebase functions:secrets:set SMTP_HOST
#   firebase functions:secrets:set SMTP_PORT
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
#   firebase functions:secrets:set MAIL_FROM
# (xem functions/README.md)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Messaging App <no-reply@yourdomain.com>"
