rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Chat 1-1 kiểu cũ: conversationId luôn có dạng "uidA_uidB" (đã sort),
    // xem utils/helpers.js -> getConversationId. Những cuộc hội thoại này
    // không có field `participants` trên document.
    function isLegacyDirectId(conversationId) {
      return conversationId.split('_').hasAny([request.auth.uid]);
    }

    // Đọc / sửa / xoá một document đã tồn tại: dùng resource.data có sẵn,
    // không cần get() lại chính document đang xét.
    function isParticipant(conversationId) {
      return isSignedIn() &&
        (
          isLegacyDirectId(conversationId) ||
          (
            'participants' in resource.data &&
            request.auth.uid in resource.data.participants
          )
        );
    }

    // Tạo mới document: resource chưa tồn tại nên phải dùng request.resource.
    function isNewParticipant(conversationId) {
      return isSignedIn() &&
        (
          isLegacyDirectId(conversationId) ||
          (
            'participants' in request.resource.data &&
            request.auth.uid in request.resource.data.participants
          )
        );
    }

    // Dùng cho các subcollection (messages/typing/members): phải get()
    // document cha vì resource ở đây là document con, không phải conversation.
    function isConversationMember(conversationId) {
      return isSignedIn() &&
        (
          isLegacyDirectId(conversationId) ||
          (
            exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          )
        );
    }

    // Thành viên bị chặn (blockedMembers trên document conversation)
    // không được tạo tin nhắn mới, kể cả khi họ vẫn còn trong participants.
    // Không ảnh hưởng chat 1-1 (không có field này).
    function isBlockedMember(conversationId) {
      return !isLegacyDirectId(conversationId) &&
        request.auth.uid in
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('blockedMembers', []);
    }

    // Khi nhóm bật "Chỉ trưởng/phó nhóm được nhắn tin"
    // (onlyAdminsCanSend == true), chỉ chủ nhóm (owner) hoặc admin
    // (phó nhóm) mới được tạo tin nhắn mới. Không ảnh hưởng đến chat
    // 1-1 (không có field này).
    function canSendMessage(conversationId) {
      return isConversationMember(conversationId) &&
        !isBlockedMember(conversationId) &&
        (
          isLegacyDirectId(conversationId) ||
          !(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
              .get('onlyAdminsCanSend', false) == true
          ) ||
          request.auth.uid ==
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.owner ||
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('admins', [])
        );
    }

    // =========================
    // USERS
    // =========================
    // Mọi người dùng đã đăng nhập có thể xem danh sách user (để hiển thị sidebar),
    // nhưng chỉ được sửa hồ sơ của chính mình.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // =========================
    // CONVERSATIONS
    // =========================
    match /conversations/{conversationId} {
      allow read, update, delete: if isParticipant(conversationId);
      allow create: if isNewParticipant(conversationId);

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);

        allow create: if canSendMessage(conversationId) &&
          request.resource.data.sender == request.auth.uid;

        // Cho phép người gửi sửa/thu hồi tin nhắn của chính họ,
        // và cho phép các thành viên khác cập nhật trạng thái "đã xem" / reactions.
        allow update: if isConversationMember(conversationId);

        allow delete: if isConversationMember(conversationId) &&
          resource.data.sender == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if isConversationMember(conversationId);
        allow write: if isConversationMember(conversationId) && request.auth.uid == uid;
      }

      match /members/{uid} {
        allow read: if isConversationMember(conversationId);
        allow write: if isConversationMember(conversationId);
      }
    }

    // =========================
    // OTP_REQUESTS
    // =========================
    // Chỉ Cloud Functions (Admin SDK, bỏ qua Security Rules) mới được đọc/ghi
    // collection này — client không bao giờ được truy cập trực tiếp, kể cả
    // đọc, để không lộ otpHash. Rule dưới đây chỉ để tường minh hoá việc này
    // (mặc định Firestore đã từ chối mọi path không match rule nào).
    match /otp_requests/{email} {
      allow read, write: if false;
    }
  }
}
